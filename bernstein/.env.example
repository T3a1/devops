# Copy this file to .env and fill in the values:  cp .env.example .env
# .env is never committed (see .gitignore).

# --- Application secrets (required) ---
# Generate strong values with: openssl rand -hex 16
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me

# --- Used by compose.yml only (Kubernetes reads them from k8s/base/01-config.yaml) ---
POSTGRES_USER=poll
POSTGRES_DB=poll

# --- Azure (required by scripts/azure-infra.sh and scripts/deploy.sh azure) ---
# Subscription id: az account list -o table
AZURE_SUBSCRIPTION_ID=
# Region: an Azure for Students subscription only allows switzerlandnorth, denmarkeast,
# belgiumcentral, germanywestcentral and italynorth (no B-series in germanywestcentral).
# Check: az policy assignment list --query "[].parameters.listOfAllowedLocations.value" -o tsv
AZURE_LOCATION=denmarkeast
AZURE_RESOURCE_GROUP=rg-bernstein
# Registry name: unique across Azure, 5 to 50 lowercase letters and digits
AZURE_ACR_NAME=
AZURE_AKS_NAME=aks-bernstein
AKS_NODE_COUNT=2
AKS_NODE_SIZE=Standard_B2s
